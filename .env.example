# Bot-Token -- via @BotFather anlegen
TELEGRAM_BOT_TOKEN=

# Nur Erstbefuellung der Autorisierungs-DB (einmalig bei leerer DB). Danach laeuft alles
# dynamisch ueber /authorize, /deauthorize und die Autorisieren/Ablehnen-Buttons.
AUTHORIZED_CHAT_IDS=

LEDGER_PATH=data/schulden.xlsx
LOG_PATH=logs/bot.log
DB_PATH=data/schuldentracker.db

# Chat-ID des Superusers -- bekommt zusaetzlich /restart und ist immer autorisiert.
SUPERUSER_CHAT_ID=

# Chat-ID, an die taeglich automatisch (und per /backup manuell) die Excel-Datei + die
# Datenbank geschickt werden -- fest, unabhaengig vom Superuser.
BACKUP_CHAT_ID=
